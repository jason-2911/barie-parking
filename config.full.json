{
  "device": {
    "id": "opi4_a1b2c3d4",
    "id_prefix": "pk_",
    "auto_id": true,
    "description": "Tầng B1 - Vào & Ra",
    "type": "full",
    "has_cash_reader": true,
    "has_display": true,
    "has_audio": true
  },
  "vehicle_sensors": [
    {
      "barrier_id": "01",
      "enabled": true,
      "chip_path": "/dev/gpiochip0",
      "line_offset": 17,
      "active_low": true,
      "bias_pull_up": true,
      "debounce_us": 20000,
      "clear_delay_ms": 1500
    },
    {
      "barrier_id": "02",
      "enabled": true,
      "chip_path": "/dev/gpiochip0",
      "line_offset": 18,
      "active_low": true,
      "bias_pull_up": true,
      "debounce_us": 20000,
      "clear_delay_ms": 1500
    }
  ],
  "mqtt": {
    "host": "localhost",
    "port": 1883,
    "username": "parking",
    "password": "parking123",
    "keepalive_seconds": 10
  },
  "barriers": [
    {
      "id": "01",
      "direction": "entry",
      "modbus_addr": 1,
      "description": "Cần B1 - Vào",
      "auto_close_seconds": 8,
      "audio_channel": "left"
    },
    {
      "id": "02",
      "direction": "exit",
      "modbus_addr": 2,
      "description": "Cần B1 - Ra",
      "auto_close_seconds": 10,
      "audio_channel": "right"
    }
  ],
  "serial": {
    "barrier_port": "/dev/ttyUSB0",
    "barrier_baud": 19200,
    "nv9_port": "/dev/ttyACM0"
  },
  "audio": {
    "sound_dir": "resources/sounds",
    "volume": 90,
    "device_left": "parking_left",
    "device_right": "parking_right",
    "sounds": {
      "system_ready":    "system_ready.wav",
      "open_entry":      "open_entry.wav",
      "open_exit":       "open_exit.wav",
      "payment_success": "payment_success.wav",
      "monthly_valid":   "monthly_valid.wav",
      "insert_money":    "insert_money.wav",
      "thank_you":       "thank_you.wav",
      "error":           "error.wav"
    }
  },
  "ui": {
    "fullscreen": true,
    "width": 1440,
    "height": 900,
    "payment_timeout_seconds": 300,
    "style": "dark"
  },
  "logging": {
    "path": "/usr/local/bin/parking/log/parking.log",
    "max_size_mb": 10,
    "max_archives": 5,
    "also_stderr": true
  }
}
