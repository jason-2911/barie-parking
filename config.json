{
  "device": {
    "id": "opi4_a1b2c3d4",
    "id_prefix": "pk_",
    "auto_id": true,
    "description": "Tầng B1 - Làn ra",
    "type": "exit_only",
    "has_cash_reader": true,
    "has_display": true,
    "has_audio": true
  },
  "vehicle_sensor": {
    "enabled": true,
    "chip_path": "/dev/gpiochip0",
    "line_offset": 17,
    "active_low": true,
    "bias_pull_up": true,
    "debounce_us": 20000,
    "clear_delay_ms": 1500
  },
  "mqtt": {
    "host": "localhost",
    "port": 1883,
    "username": "parking",
    "password": "parking123",
    "keepalive_seconds": 60,
    "ping_interval_min_seconds": 30,
    "ping_interval_max_seconds": 60
  },
  "barriers": [
    {
      "id": "01",
      "direction": "exit",
      "modbus_addr": 1,
      "description": "Cần B1 - Ra",
      "auto_close_seconds": 10
    }
  ],
  "serial": {
    "barrier_port": "/dev/ttyUSB0",
    "barrier_baud": 9600,
    "nv9_port": "/dev/ttyUSB1"
  },
  "audio": {
    "sound_dir": "resources/sounds",
    "volume": 90,
    "sounds": {
      "open_entry":      "open_entry.wav",
      "open_exit":       "open_exit.wav",
      "payment_success": "payment_success.wav",
      "monthly_valid":   "monthly_valid.wav",
      "insert_money":    "insert_money.wav",
      "thank_you":       "thank_you.wav",
      "error":           "error.wav"
    }
  },
  "ui": {
    "fullscreen": true,
    "width": 1920,
    "height": 1080,
    "payment_timeout_seconds": 300,
    "style": "dark"
  },
  "logging": {
    "path": "/var/log/parking/parking.log",
    "max_size_mb": 10,
    "max_archives": 5,
    "also_stderr": true
  }
}
